# Copy to .env and fill in as needed. .env is gitignored — never commit real secrets.
#
# Docker Compose reads this file natively for ${VAR} substitution in
# docker-compose.yml / docker-compose-dev.yml. Values passed through to the
# container are written by bin/entrypoint.sh into etc/conf/server.conf and
# etc/conf/db_config.json. All variables below have working defaults for
# local dev — nothing here is required just to start the service.
#
# common/util/app_config.py also generically applies any REGISTRY_<KEY>
# variable found in the process environment as an override for the matching
# etc/conf/server.conf / etc/conf/persistence.conf key, beyond the list
# below — this file only documents the ones docker-compose.yml already
# wires up plus persistence credentials.

# ============================================================
# Docker Compose — etc/conf/server.conf overrides (optional; defaults shown)
# ============================================================
# REGISTRY_IP=0.0.0.0
# REGISTRY_PORT=5000
# REGISTRY_ENABLE_HTTPS=true
# REGISTRY_VERIFY_CLIENT=false
# REGISTRY_OWNER_ISOLATION_ENABLED=false
# REGISTRY_AGENT_APPROVAL_ENABLED=false
# REGISTRY_SIGNATURE_VALIDATION_ENABLED=false
# REGISTRY_FORWARDED_ALLOW_IPS=*

# ============================================================
# Docker Compose — optional PostgreSQL persistence (docker-compose.yml).
# Only read when REGISTRY_PERSISTENCE_MODE=postgresql.
# ============================================================
# REGISTRY_PERSISTENCE_MODE=postgresql
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=registry_center
# DB_USERNAME=
# DB_PASSWORD=
